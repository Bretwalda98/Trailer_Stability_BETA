(load "C:/Users/Harry/Documents/Codex/2026-07-16/the/github-publish/Trailer_Stability_BETA/tools/autocad/SARENS_TRAILERDRAFTSMAN/SARENS_TRAILERDRAFTSMAN_v1.1.lsp")
(setq sartd:test-cad-path "C:/Users/Harry/Documents/Codex/2026-07-16/the/github-publish/Trailer_Stability_BETA/tools/autocad/test-fixtures/valid-compact-four-point.sartd")
(setq sartd:test-result-path "C:/Users/Harry/Documents/Codex/2026-07-16/the/github-publish/Trailer_Stability_BETA/tools/autocad/test-compact-cad-full.result")
(setq sartd:test-cad-data (sartd:v120-read-compact sartd:test-cad-path))
(setq sartd:*v118-run-source-label* "compact CAD full AutoCAD smoke test")
(setq sartd:test-cad-draw (if sartd:test-cad-data (vl-catch-all-apply 'sartd:v118-run-model-from-data (list sartd:test-cad-data)) nil))
(setq sartd:test-cad-entities (ssget "_X" '((8 . "SARTD-*"))))
(setq sartd:test-cad-boundary (ssget "_X" '((8 . "SARTD-HYD-RESULT"))))
(setq sartd:test-cad-pass (and sartd:test-cad-draw (not (vl-catch-all-error-p sartd:test-cad-draw)) sartd:test-cad-entities (> (sslength sartd:test-cad-entities) 0) sartd:test-cad-boundary (> (sslength sartd:test-cad-boundary) 0)))
(setq sartd:test-result-handle (open sartd:test-result-path "w"))
(if sartd:test-result-handle
  (progn
    (write-line (if sartd:test-cad-pass "SARTD-CAD-FULL-DRAW-PASS" "SARTD-CAD-FULL-DRAW-FAIL") sartd:test-result-handle)
    (write-line (strcat "ENTITY-COUNT=" (itoa (if sartd:test-cad-entities (sslength sartd:test-cad-entities) 0))) sartd:test-result-handle)
    (write-line (strcat "BOUNDARY-COUNT=" (itoa (if sartd:test-cad-boundary (sslength sartd:test-cad-boundary) 0))) sartd:test-result-handle)
    (if (vl-catch-all-error-p sartd:test-cad-draw)
      (write-line (strcat "ERROR=" (vl-catch-all-error-message sartd:test-cad-draw)) sartd:test-result-handle))
    (close sartd:test-result-handle)))
(command "_.QUIT" "_N")
