(load "C:/Users/Harry/Documents/Codex/2026-07-16/the/github-publish/Trailer_Stability_BETA/tools/autocad/SARENS_TRAILERDRAFTSMAN/SARENS_TRAILERDRAFTSMAN_v1.1.lsp")
(setq sartd:test-cad-path "C:/Users/Harry/Documents/Codex/2026-07-16/the/github-publish/Trailer_Stability_BETA/tools/autocad/test-fixtures/valid-compact-four-point.sartd")
(setq sartd:test-cad-data (sartd:v120-read-compact sartd:test-cad-path))
(setq sartd:test-cad-group4 (if sartd:test-cad-data (sartd:v121-group-record 4 (sartd:g 'cad-group-metrics sartd:test-cad-data)) nil))
(if (and sartd:test-cad-data
         (= (sartd:g 'cargo-name sartd:test-cad-data) "Compact CAD Test")
         (= (length (sartd:g 'trailers sartd:test-cad-data)) 2)
         (= (sartd:g 'total-axles sartd:test-cad-data) 20)
         (= (length (sartd:g 'hydraulic-grouping sartd:test-cad-data)) 4)
         (= (length (sartd:g 'cad-group-metrics sartd:test-cad-data)) 4)
         (= (sartd:g 'hydraulic-mode sartd:test-cad-data) "FOUR_POINT")
         (= (length (sartd:g 'cad-boundary sartd:test-cad-data)) 4)
         (< (abs (- (sartd:g 'trailer-selfweight sartd:test-cad-data) 90.0)) 0.000001)
         (< (abs (- (sartd:g 'powerpack-weight sartd:test-cad-data) 12.4)) 0.000001)
         (< (abs (- (sartd:g 'ground-bearing-pressure sartd:test-cad-data) 14.068195)) 0.000001)
         (< (abs (- (sartd:g 'export-cogx sartd:test-cad-data) 0.5)) 0.000001)
         sartd:test-cad-group4
         (< (abs (- (sartd:g 'gbp sartd:test-cad-group4) 16.108172)) 0.000001)
         (< (abs (- (sartd:g 'pressure-d sartd:test-cad-group4) 271.0)) 0.000001))
  (princ "\nSARTD-CAD-PARSE-PASS")
  (princ "\nSARTD-CAD-PARSE-FAIL"))
(princ)
