(load "C:/Users/Harry/Documents/Codex/2026-07-16/the/github-publish/Trailer_Stability_BETA/tools/autocad/SARENS_TRAILERDRAFTSMAN/SARENS_TRAILERDRAFTSMAN_v1.1.lsp")

; A real validated JSON fixture must expose case and trailer values to the ordinary PaperSpace map.
(setq sartd:test-json-data
  (sartd:json-load-validated
    "C:/Users/Harry/Documents/Codex/2026-07-16/the/github-publish/Trailer_Stability_BETA/tools/autocad/test-fixtures/valid-four-point.json"))
(setq sartd:test-json-attrs (if sartd:test-json-data (sartd:attr-map sartd:test-json-data) nil))
(if (and sartd:test-json-attrs
         (= (cdr (assoc "PROJECT" sartd:test-json-attrs)) "AUTOCAD-FOUR-POINT")
         (= (cdr (assoc "CLIENT" sartd:test-json-attrs)) "TEST")
         (= (cdr (assoc "TOTALNUMBEROFAXLELINES" sartd:test-json-attrs)) "4")
         (= (cdr (assoc "TOTALNUMBEROFPOWERPACKS" sartd:test-json-attrs)) "2"))
  (princ "\nV118_JSON_PAPERSPACE_DATA_PASS")
  (princ "\nV118_JSON_PAPERSPACE_DATA_FAIL"))

; Excel: one source selection, one workbook read, one shared-workflow invocation.
(setq sartd:test-excel-select-count 0)
(setq sartd:test-excel-read-count 0)
(setq sartd:test-excel-workflow-count 0)
(defun sartd:v59-select-excel-source ()
  (setq sartd:test-excel-select-count (1+ sartd:test-excel-select-count))
  (setq sartd:*v59-excel-source-label* "Test workbook")
  "Last")
(defun sartd:read-data (silent)
  (setq sartd:test-excel-read-count (1+ sartd:test-excel-read-count))
  (list (cons 'case-name "EXCEL TEST")))
(defun sartd:v116-ensure-block-library () T)
(defun sartd:v50-clear-scale-cache () T)
(defun sartd:v118-run-data-workflow (data sourceLabel)
  (setq sartd:test-excel-workflow-count (1+ sartd:test-excel-workflow-count))
  T)
(sartd:v118-run-excel-import)
(if (and (= sartd:test-excel-select-count 1)
         (= sartd:test-excel-read-count 1)
         (= sartd:test-excel-workflow-count 1))
  (princ "\nV118_EXCEL_SINGLE_SELECTION_PASS")
  (princ "\nV118_EXCEL_SINGLE_SELECTION_FAIL"))

; JSON: one picker, one parse/validation call, one shared-workflow invocation.
(setq sartd:test-json-picker-count 0)
(setq sartd:test-json-load-count 0)
(setq sartd:test-json-workflow-count 0)
(defun sartd:v117-json-prompt-source-path ()
  (setq sartd:test-json-picker-count (1+ sartd:test-json-picker-count))
  "C:/TEMP/TRAILER-STABILITY-CAD-DATA-TEST.json")
(defun sartd:json-load-validated (path)
  (setq sartd:test-json-load-count (1+ sartd:test-json-load-count))
  (list (cons 'case-name "JSON TEST")))
(defun sartd:json-summary (data) T)
(defun sartd:json-log (message) T)
(defun sartd:v118-run-data-workflow (data sourceLabel)
  (setq sartd:test-json-workflow-count (1+ sartd:test-json-workflow-count))
  T)
(sartd:v118-run-json-import)
(if (and (= sartd:test-json-picker-count 1)
         (= sartd:test-json-load-count 1)
         (= sartd:test-json-workflow-count 1))
  (princ "\nV118_JSON_SINGLE_SELECTION_PASS")
  (princ "\nV118_JSON_SINGLE_SELECTION_FAIL"))

; The final SARTDRUN command must route to the selected source.
(setq sartd:test-route nil)
(defun sartd:v118-select-run-import () "JSON")
(defun sartd:v118-run-json-import () (setq sartd:test-route "JSON") T)
(defun sartd:v118-run-excel-import () (setq sartd:test-route "Excel") T)
(c:SARTDRUN)
(if (= sartd:test-route "JSON")
  (princ "\nV118_SARTDRUN_JSON_ROUTE_PASS")
  (princ "\nV118_SARTDRUN_JSON_ROUTE_FAIL"))

(setq sartd:test-route nil)
(defun sartd:v118-select-run-import () "Excel")
(c:SARTDRUN)
(if (= sartd:test-route "Excel")
  (princ "\nV118_SARTDRUN_EXCEL_ROUTE_PASS")
  (princ "\nV118_SARTDRUN_EXCEL_ROUTE_FAIL"))

(princ)
