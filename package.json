{
  "name": "trailer-stability-native-web",
  "version": "0.7.0-standalone.1",
  "private": true,
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:engine": "tsc -p tsconfig.tests.json && node scripts/prepare-engine-test-output.mjs && node test-output/cjs/tests/engine-and-workbook.test.js && node test-output/cjs/tests/geometry-adapter.test.js && node test-output/cjs/tests/bed-placement.test.js",
    "benchmark:colossal": "tsc -p tsconfig.tests.json && node scripts/prepare-engine-test-output.mjs && node test-output/cjs/tests/colossal-cargo-search.benchmark.js",
    "benchmark:matrix": "tsc -p tsconfig.tests.json && node scripts/prepare-engine-test-output.mjs && node test-output/cjs/tests/math-search-matrix.test.js",
    "benchmark:supports": "tsc -p tsconfig.tests.json && node scripts/prepare-engine-test-output.mjs && node test-output/cjs/tests/support-settling.benchmark.js",
    "test": "pnpm run typecheck && pnpm run test:engine && pnpm run build && node tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@tabler/icons-react": "3.34.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "hyperformula": "^3.3.0",
    "jspdf": "^4.2.1",
    "katex": "^0.18.4",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
